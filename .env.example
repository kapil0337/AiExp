# ─────────────────────────────────────────────────────────────
# 🌸 Bloom Budget — environment
# Copy to .env and fill in.  Never commit the real .env
# ─────────────────────────────────────────────────────────────

# Database ───────────────────────────────────────────────────
# Local dev (default, no setup needed):
DATABASE_URL=sqlite:///./data/bloom.db
# Docker compose:
# DATABASE_URL=postgresql+psycopg://bloom:bloom@db:5432/bloom
# Vercel / Neon / Supabase (postgres:// is auto-upgraded to psycopg):
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# NVIDIA NIM — the sassy money coach 💅 ───────────────────────
# Get a free key at https://build.nvidia.com  (it is OpenAI-compatible)
# Leave blank and the app falls back to built-in quirky one-liners.
NVIDIA_API_KEY=
# 8b replies in ~1s. Avoid meta/llama-3.3-70b-instruct — that endpoint accepts
# the connection then never sends a response (verified 2026-08-24), and
# meta/llama-3.1-70b-instruct takes ~13s, too slow for the UI bubble.
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Google Sign-In — see README "Setting up Google Sign-In" ─────
GOOGLE_CLIENT_ID=
ALLOWED_EMAILS=
# generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# App ────────────────────────────────────────────────────────
APP_NAME= Stop Spending
DEFAULT_CURRENCY=INR
